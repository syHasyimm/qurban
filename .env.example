# Local PostgreSQL. Keep DATABASE_URL consistent with POSTGRES_*.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qurban
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qurban

# Generate a private value: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
